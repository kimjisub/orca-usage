{
  "name": "orca-usage",
  "version": "1.1.0",
  "description": "Backend and terminal screen for the Claude and Codex accounts managed by Orca: usage history, token refresh and automatic account switching, kept running by launchd.",
  "license": "MIT",
  "author": "Jisub Kim (https://github.com/kimjisub)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimjisub/orca-usage.git"
  },
  "homepage": "https://github.com/kimjisub/orca-usage#readme",
  "bugs": {
    "url": "https://github.com/kimjisub/orca-usage/issues"
  },
  "keywords": [
    "claude",
    "orca",
    "cli",
    "tui",
    "ink",
    "rate-limit",
    "usage"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "bin": {
    "orca-usage": "./orca-usage"
  },
  "scripts": {
    "start": "bun run src/cli.jsx",
    "once": "bun run src/cli.jsx --once",
    "build": "esbuild src/cli.jsx --bundle --platform=node --format=esm --outfile=bin/orca-usage.js --packages=external --banner:js='#!/usr/bin/env node'",
    "test": "bun test"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
