#!/bin/sh
# bun 이 JSX 를 그대로 실행하므로 빌드 단계가 없다.
#
# PATH 에 심볼릭 링크로 걸어 두고 쓰는 경우가 많다. $0 을 그대로 쓰면 링크가
# 놓인 자리를 저장소로 잘못 짚으므로 링크를 끝까지 따라간 뒤 기준을 잡는다.
# 링크가 서로를 가리키면 이 반복은 끝나지 않는다. readlink -f 와 같은 한도를 둔다.
target=$0
hops=0
while [ -L "$target" ]; do
  hops=$((hops + 1))
  if [ "$hops" -gt 40 ]; then
    echo "orca-usage: 심볼릭 링크가 서로를 가리킵니다: $0" >&2
    exit 1
  fi
  link=$(readlink "$target")
  case $link in
    /*) target=$link ;;
    *) target=$(dirname "$target")/$link ;;
  esac
done
root=$(cd "$(dirname "$target")" && pwd)
# 화면은 React production 빌드로 돌아야 한다. 개발 빌드로 그리면 네이티브 메모리가
# 샌다. bun 은 시작할 때의 NODE_ENV 로 JSX 를 변환하므로 여기서 건다(src/react-env.js).
#
# 화면이 76 으로 끝나면 업데이트 뒤 새 코드로 다시 떠야 한다는 뜻이다. 여기서 다시
# 띄운다. 화면이 스스로 자식을 띄우면 옛 화면이 메모리를 쥔 채 남는다(src/launcher.js).
export ORCA_USAGE_LAUNCHER=1
while :; do
  NODE_ENV=production bun run "$root/src/cli.jsx" "$@"
  code=$?
  [ "$code" -eq 76 ] || exit "$code"
done
